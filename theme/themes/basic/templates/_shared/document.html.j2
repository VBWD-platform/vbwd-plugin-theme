{#- The HTML shell every themed page extends. No colours: they come from CMS styles / tokens. -#}
<!DOCTYPE html>
<html lang="{{ language|default('en') }}">
<head>
{%- block head %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="vbwd-frontend" content="theme">
  <title>{% block title %}{{ page_title|default('') }}{% endblock %}</title>
  {%- include "_shared/partials/hreflang.html.j2" %}
  {%- block stylesheets %}
  <link rel="stylesheet" href="{{ theme_stylesheet_url() }}">
  {%- endblock %}
{%- endblock %}
</head>
<body{% block body_attributes %}{% endblock %}>
{%- block body %}
  {% include "_shared/partials/header.html.j2" %}
  <main id="main">{% block content %}{% endblock %}</main>
  {% include "_shared/partials/footer.html.j2" %}
{%- endblock %}
{%- block scripts %}
  <script src="{{ asset('_shared/js/htmx.min.js') }}" defer></script>
  <script src="{{ asset('_shared/js/sse.js') }}" defer></script>
  <script src="{{ asset('_shared/js/vbwd-theme.js') }}" defer></script>
{%- endblock %}
</body>
</html>
